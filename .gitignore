# ---- 运行产物 / 缓存 / 结果 ----
# 忽略目录内容，保留子目录 .gitkeep 占位
work_dirs/**
!work_dirs/**/
!work_dirs/**/.gitkeep

# 感知 / 分块缓存（显式再挡一层，避免误 add）
work_dirs/cache/perception/
work_dirs/cache/tiles/
work_dirs/facts/**
work_dirs/vis/**
work_dirs/reports/**
work_dirs/ingest/**
work_dirs/review_queue/**
!work_dirs/**/.gitkeep

# HuggingFace / 本地工具缓存
.cache/
**/.cache/

# 仅仓库根目录临时调试图（保留 data/、samples/、docs/ 中的图片）
/*.png
/*.jpg
/*.jpeg
/*.webp

# 常见临时输出
*.tmp
*.temp
*.bak
*.swp
*~

# ---- 本地大图纸上传（保留 demo_*.png 等样例）----
data/input/*.pdf
data/input/*.PDF
data/input/test.*
!data/input/README.md
!data/input/.gitkeep

# ---- 第三方 ----
third_party/

