{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edqi.local/schemas/rule.schema.json",
  "title": "EDQI Rule",
  "type": "object",
  "required": ["rule_id", "name", "severity", "status", "entities", "logic", "message"],
  "additionalProperties": true,
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "severity": { "type": "string", "enum": ["error", "warn", "info"] },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated", "invalid"] },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string" },
    "drawing_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_id", "locate_query", "fields"],
        "properties": {
          "entity_id": { "type": "string" },
          "locate_query": { "type": "string" },
          "cardinality": {
            "type": "string",
            "enum": ["one", "many"],
            "default": "one"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "parse_hint": { "type": "string" },
                "required": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    },
    "logic": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
            "enum": [
            "not_empty", "eq", "neq", "in", "regex",
            "count_gte", "count_lte", "ref_exists",
            "bbox_overlap_count_lte",
            "and", "or", "not"
          ]
        },
        "path": { "type": "string" },
        "value": {},
        "pattern": { "type": "string" },
        "count": { "type": "integer" },
        "iou_thr": { "type": "number" },
        "min_intersection": { "type": "number" },
        "min_overlap_ratio": { "type": "number" },
        "min_box_side": { "type": "number" },
        "ignore_horizontal_neighbors": { "type": "boolean" },
        "args": {
          "type": "array",
          "items": { "$ref": "#/properties/logic" }
        },
        "arg": { "$ref": "#/properties/logic" }
      }
    },
    "message": { "type": "string" }
  }
}
